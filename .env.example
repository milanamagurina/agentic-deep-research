NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=MiniMaxAI/MiniMax-M3

# Optional stronger reasoning model (hypotheses, adversarial planning, inference verification, synthesis).
# Use an exact ID from: python -m evidence_research.llm.gateway --list-models
NEBIUS_REASONING_MODEL=

TAVILY_API_KEY=

MAX_RESEARCH_ITERATIONS=5
MAX_SEARCH_QUERIES=20
MAX_EXTRACTED_SOURCES=30
MAX_MODEL_CALLS=50

MIN_CLAIM_CONFIDENCE=0.75
MIN_EVIDENCE_SUFFICIENCY=0.70

# Weight of each further item from the same provenance cluster (heuristic).
DEPENDENT_EVIDENCE_DISCOUNT=0.15

# SQLite database and run snapshots
DATA_DIR=data

STREAMLIT_SERVER_HEADLESS=true
