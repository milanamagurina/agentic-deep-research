NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=MiniMaxAI/MiniMax-M3

# Optional stronger reasoning model (hypotheses, adversarial and contradiction planning, scientific review,
# inference verification, deletion test, synthesis). Use an exact ID from:
#   python -m evidence_research.llm.gateway --list-models
# e.g. reflection/beam (listed in the catalog and tested with this project on 2026-10-18).
NEBIUS_REASONING_MODEL=

TAVILY_API_KEY=

# Upper caps. Depth presets (fast / standard / deep) never exceed them.
MAX_RESEARCH_ITERATIONS=5
MAX_SEARCH_QUERIES=20
MAX_EXTRACTED_SOURCES=30
MAX_MODEL_CALLS=50

MIN_CLAIM_CONFIDENCE=0.75
MIN_EVIDENCE_SUFFICIENCY=0.70

# Weight of each further item from the same provenance cluster (heuristic).
DEPENDENT_EVIDENCE_DISCOUNT=0.15

# SQLite database and run snapshots
DATA_DIR=data

STREAMLIT_SERVER_HEADLESS=true
