# Copy to .env and fill in. .env is git- and docker-ignored.
NEBIUS_API_KEY=
TAVILY_API_KEY=

# Optional
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=MiniMaxAI/MiniMax-M3
# Per-role overrides (default to NEBIUS_MODEL). A different checker model gives an independent second opinion.
# NEBIUS_WORKER_MODEL=<e.g. a Nemotron 3 Nano id from the Token Factory catalog>
# NEBIUS_CHECKER_MODEL=<Beam model id from the Token Factory catalog>
# MAX_PARALLEL_RESEARCHERS=4
# RECURSION_LIMIT=250
# RUNS_DIR=runs
